# Copy this file to `.env` (in the hike-now/ folder) and fill in the values.
# `.env` is git-ignored: never commit real credentials.
# The values for the shared team Supabase project are provided separately
# (see "Environment variables" in the root README).

# Server-only PostgreSQL connection string (Supabase -> Project Settings -> Database).
# Must be able to bypass RLS. Never prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase project URL and anon (public) key. Used for review photo uploads (Storage).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
